# ARES environment configuration — copy to .env and fill in locally.
# NEVER commit .env. NEVER paste credentials into chat, code, or logs.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Access control (set this before exposing ARES to the internet) ---------
# When set, every /api route and the client WebSocket require this token.
# The browser asks for it once and stores it locally; it is never bundled
# into the frontend JavaScript.
ARES_ACCESS_TOKEN=

# ---- Windows MT5 bridge ------------------------------------------------------
# The MetaTrader5 Python package is Windows-only, so a Linux/cloud backend
# reaches MT5 through a bridge process that runs beside the terminal on Windows
# and dials out to this server. Both sides must share this token.
# See docs/MT5_BRIDGE.md.
ARES_BRIDGE_TOKEN=

# ---- MT5 credentials ---------------------------------------------------------
# These belong on the BRIDGE machine's .env, not on the server — unless you run
# ARES itself on Windows, in which case it drives the terminal directly.
# Use a DEMO account. ARES refuses live-money execution in this build.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: explicit terminal path if auto-detection fails, e.g.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# ---- Market data ---------------------------------------------------------------
# "mt5"        = real broker data only; OFFLINE when no bridge/terminal is live.
# "simulation" = explicitly-enabled SIMULATED feed for demo and testing.
#                Every simulated payload is labelled SIMULATED end to end.
ARES_MARKET_DATA__MODE=mt5

# ---- News feed -------------------------------------------------------------------
# Real RSS ingestion from public financial sources. Requires outbound HTTPS to
# those hosts; when they are unreachable ARES shows no headlines and says why,
# rather than inventing any.
ARES_NEWS__NEWS_FEED_ENABLED=true
# ARES_NEWS__REFRESH_INTERVAL_SECONDS=300

# ---- AI provider (optional narration layer) ----------------------------------------
# One of: none | gemini | openai | anthropic
# The model only narrates analysis ARES already computed; it never invents a
# bias, a confidence score, or an execution.
ARES_AI__PROVIDER=none
ARES_AI__API_KEY=
# ARES_AI__MODEL=

# ---- Risk limits (optional; sensible defaults apply, editable in Settings) ------------
# ARES_RISK__MAX_DAILY_LOSS=500
# ARES_RISK__MAX_DRAWDOWN_PERCENT=10
# ARES_RISK__MAX_OPEN_POSITIONS=5
# ARES_RISK__MAX_POSITION_SIZE_LOTS=1.0
# ARES_RISK__MAX_SPREAD_POINTS=40

# ---- Execution ----------------------------------------------------------------------------
# ARES_EXECUTION__PAPER_STARTING_BALANCE=10000
# Live trading is NOT available in this build; the engine refuses orders even
# when this flag is set. It exists so the architecture stays explicit.
# ARES_EXECUTION__LIVE_TRADING_ENABLED=false

# ---- System ------------------------------------------------------------------------------------
# ARES_SYSTEM__PORT=8000
# ARES_SYSTEM__LOG_LEVEL=INFO
# ARES_SYSTEM__DATABASE_URL=sqlite+aiosqlite:///./data/ares.db
