# ARES environment configuration — copy to .env and fill in locally.
# NEVER commit .env. NEVER paste credentials into chat, code, or logs.

# ---- MetaTrader 5 (required for live market data) --------------------------
# Use a DEMO account. ARES refuses execution on live accounts in this build.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: explicit terminal path if auto-detection fails (Windows), e.g.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# ---- Market data ------------------------------------------------------------
# "mt5" (default) = real broker data only; OFFLINE when MT5 unavailable.
# "simulation"    = explicitly-enabled SIMULATED feed for demo/testing.
#                   Every simulated payload is labeled source=SIMULATED.
ARES_MARKET_DATA__MODE=mt5

# ---- AI provider (optional narration layer) ----------------------------------
# One of: none | gemini | openai | anthropic
ARES_AI__PROVIDER=none
ARES_AI__API_KEY=
# Optional model override, e.g. gemini-2.0-flash / gpt-4o-mini
ARES_AI__MODEL=

# ---- Risk limits (all optional; sensible defaults apply) -----------------------
# ARES_RISK__MAX_DAILY_LOSS=500
# ARES_RISK__MAX_DRAWDOWN_PERCENT=10
# ARES_RISK__MAX_OPEN_POSITIONS=5
# ARES_RISK__MAX_POSITION_SIZE_LOTS=1.0
# ARES_RISK__MAX_SPREAD_POINTS=40

# ---- Execution -------------------------------------------------------------------
# Paper trading starting balance
# ARES_EXECUTION__PAPER_STARTING_BALANCE=10000
# Live trading is NOT available in this build; this flag exists for future
# architecture only and the engine refuses orders when it is set.
# ARES_EXECUTION__LIVE_TRADING_ENABLED=false

# ---- System -------------------------------------------------------------------------
# ARES_SYSTEM__PORT=8000
# ARES_SYSTEM__LOG_LEVEL=INFO
